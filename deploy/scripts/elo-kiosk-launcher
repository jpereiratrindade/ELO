#!/usr/bin/env bash
# ==============================================================================
# ELO Kiosk Launcher — Hardware Backend Resolver for Raspberry Pi & Linux
# ==============================================================================
set -e

USER_UID=$(id -u)
if [ -d "/run/user/${USER_UID}" ]; then
    export XDG_RUNTIME_DIR="/run/user/${USER_UID}"
else
    export XDG_RUNTIME_DIR="/tmp/elo-runtime-${USER_UID}"
    mkdir -p "${XDG_RUNTIME_DIR}"
    chmod 0700 "${XDG_RUNTIME_DIR}"
fi

# Detect active Wayland/X11 sockets if environment is not set
if [ -z "$WAYLAND_DISPLAY" ] && [ -S "${XDG_RUNTIME_DIR}/wayland-0" ]; then
    export WAYLAND_DISPLAY="wayland-0"
fi
if [ -z "$DISPLAY" ] && [ -S "/tmp/.X11-unix/X0" ]; then
    export DISPLAY=":0"
fi

exec /usr/local/bin/elo-kiosk "$@"

