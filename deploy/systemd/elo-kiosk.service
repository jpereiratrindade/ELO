[Unit]
Description=ELO Autonomous Offline Kiosk (Totem UI)
After=network.target elo-admin.service sound.target systemd-user-sessions.service
Wants=elo-admin.service

[Service]
Type=simple
User=%I
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
SupplementaryGroups=video render input audio tty
WorkingDirectory=/home/%I
ExecStart=/usr/local/bin/elo-kiosk-launcher
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
